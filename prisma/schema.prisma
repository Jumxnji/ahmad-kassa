// Ahmad Mohamed Kassa — CMS database schema.
//
// Design principles:
// - UUID primary keys everywhere except true singleton config rows
//   (HomepageContent, AboutContent, SiteSettings), which use a fixed
//   well-known string id so upserts never have to guess/branch.
// - Media is a single reusable table referenced from anywhere an
//   image is needed (book covers, galleries, SEO images, logos) —
//   never duplicated per-feature.
// - Seo is its own reusable table, attached 1:1 to whatever needs it,
//   instead of repeating meta/OG/Twitter columns on every content model.
// - Only V1-required content is modelled here (Book, Homepage, About,
//   Question, ContactMessage, NewsletterSubscriber, Campaign, Media,
//   User, SiteSettings, Seo). Courses/Articles/Events/etc. are
//   deliberately NOT modelled yet — see src/features/flags.ts. Adding
//   them later follows the same repository/service/action pattern
//   already established here; it doesn't require reshaping anything
//   above.
// - NewsletterSettings/HomepageContent/AboutContent/SiteSettings are
//   singleton rows using a fixed well-known string id — see above.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  OWNER
  ADMINISTRATOR
  EDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum QuestionCategory {
  MARRIAGE
  FAMILY
  AQEEDAH
  FIQH
  RUQYAH
  MENTAL_HEALTH
  OTHER
}

/// NEW: just submitted, nobody has looked yet. IN_REVIEW: someone is
/// actively considering it. WAITING: blocked on something (more info,
/// a decision) before it can move forward. ANSWERED: a reply has been
/// given. CLOSED: the conversation is done, but not archived away.
/// ARCHIVED: removed from the active inbox view entirely.
enum QuestionStatus {
  NEW
  IN_REVIEW
  WAITING
  ANSWERED
  CLOSED
  ARCHIVED
}

enum QuestionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Who a Message was written by. Only USER (the visitor) is ever
/// created in V1 — ADMIN exists now so a future admin-reply feature is
/// a new Server Action, not a schema change.
enum SenderType {
  USER
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ContactReason {
  SPEAKING
  SEMINARS
  GENERAL
  BOOKS
  MEDIA
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

enum MediaFolder {
  IMAGES
  BOOK_COVERS
  GALLERY
  DOCUMENTS
  DOWNLOADS
  VIDEOS
}

/// DRAFT: not visible anywhere public. PUBLISHED: live on the site.
/// COMING_SOON: visible with a badge, not yet buyable. ARCHIVED: was
/// published, deliberately taken down — kept for records, never shown
/// publicly. Replaces the old `published`/`comingSoon` booleans, which
/// allowed nonsensical combinations (e.g. both true at once).
enum BookStatus {
  DRAFT
  PUBLISHED
  COMING_SOON
  ARCHIVED
}

/// PENDING: submitted, confirmation email sent, not yet clicked.
/// ACTIVE: confirmed — the only status a campaign may ever send to.
/// UNSUBSCRIBED: self-service opt-out, always resubscribable (via a
/// fresh confirmation cycle). SUPPRESSED: staff-applied hard stop
/// (e.g. a complaint handled manually). BOUNCED / COMPLAINED: set only
/// by verified Resend webhook events. Suppressed/Bounced/Complained
/// never auto-reactivate.
enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  SUPPRESSED
  BOUNCED
  COMPLAINED
}

/// Where a subscriber's signup came from — shown in the dashboard so
/// staff can see which public forms are actually driving signups.
enum SubscriberSource {
  HOMEPAGE
  FOOTER
  NEWSLETTER_PAGE
  BOOK_PAGE
  COURSES_COMING_SOON
  ADMIN_IMPORT
  OTHER
}

/// DRAFT: being written. READY: content finished, not yet sent.
/// SCHEDULED: queued for a future send (reserved — see
/// features.newsletterScheduling). SENDING: send in progress — this is
/// the state a conditional status-transition update uses as the
/// idempotency guard against a duplicate trigger. SENT: fully
/// delivered. PARTIALLY_FAILED: some recipients failed — see
/// CampaignRecipient for which. CANCELLED: a scheduled send was called
/// off before it ran.
enum CampaignStatus {
  DRAFT
  READY
  SCHEDULED
  SENDING
  SENT
  PARTIALLY_FAILED
  CANCELLED
}

/// V1 only ever uses ALL_ACTIVE (every confirmed, active subscriber).
/// Modelled as an enum now so a future segment (e.g. BY_LANGUAGE) is a
/// new value, not a schema change — see features.newsletterSegmentation.
enum CampaignAudienceType {
  ALL_ACTIVE
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
}

// ============================================================
// Identity
// ============================================================

/// Credentials-based auth (Sprint 5) lives alongside the Auth.js
/// standard tables below (Account/Session/VerificationToken) so OAuth
/// providers can be added later without touching this model.
/// `passwordHash` is nullable to allow a future OAuth-only user (e.g.
/// a student account created via Google sign-in) with no password.
model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String?
  role         Role       @default(VIEWER)
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  mfaEnabled   Boolean    @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  uploadedMedia       Media[]              @relation("MediaUploadedBy")
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  assignedQuestions   Question[]           @relation("QuestionAssignee")
  sentMessages        Message[]            @relation("MessageSender")
  internalNotes       InternalNote[]       @relation("InternalNoteAuthor")
  createdCampaigns    Campaign[]           @relation("CampaignCreatedBy")
  updatedCampaigns    Campaign[]           @relation("CampaignUpdatedBy")

  @@index([role])
  @@index([status])
  @@map("users")
}

/// Auth.js standard adapter tables. Not populated by the Credentials
/// provider today (which uses JWT sessions — see src/auth.ts), but
/// present so an OAuth provider (Google, etc.) can be added later
/// with zero schema changes.
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Reserved for database-strategy sessions (OAuth providers use this
/// automatically via the Prisma adapter). The Credentials provider
/// uses JWT sessions instead, so this stays empty until an OAuth
/// provider is added — see docs/PROJECT_MEMORY.md for why.
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Auth.js standard table for email verification / magic links.
/// Not wired to a live flow yet — reserved for a future "verify your
/// email" step.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// One-time, expiring tokens for the "forgot password" flow. A row is
/// deleted (not just marked used) once consumed, so there's nothing to
/// clean up later.
model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Architecture for future audit logging (Sprint 5 brief). Wired into
/// the security-relevant actions today (login, logout, password
/// reset, user create/update/delete/role change) — extending it to
/// content edits later is additive, not a redesign.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// Shared / reusable
// ============================================================

/// Single reusable media table. Every image/file in the CMS — book
/// covers, galleries, SEO images, the site logo — is a row here,
/// referenced by id. Nothing stores a raw upload path per-feature.
model Media {
  id           String      @id @default(uuid())
  filename     String
  url          String
  /// Downscaled preview generated at upload time for JPEG/PNG/WEBP —
  /// null for SVGs (vector, no thumbnail needed) and non-images.
  thumbnailUrl String?
  mimeType     String
  size         Int
  folder       MediaFolder @default(IMAGES)
  altText      String?
  width        Int?
  height       Int?
  uploadedById String?
  uploadedBy   User?       @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  seoOgImage      Seo?             @relation("SeoOgImage")
  seoTwitterImage Seo?             @relation("SeoTwitterImage")
  bookCoverOf     Book?            @relation("BookCover")
  bookGalleryId   String?
  bookGallery     Book?            @relation("BookGallery", fields: [bookGalleryId], references: [id], onDelete: SetNull)
  homepageHeroOf  HomepageContent? @relation("HomepageHeroImage")
  siteLogoOf      SiteSettings?    @relation("SiteLogo")

  @@index([folder])
  @@index([uploadedById])
  @@index([bookGalleryId])
  @@map("media")
}

/// Reusable SEO fields, attached 1:1 to whatever needs them (a book,
/// the homepage, the about page, or the site-wide default). Never
/// duplicate meta/OG/Twitter columns onto individual content models.
model Seo {
  id              String   @id @default(uuid())
  metaTitle       String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  ogImageId       String?  @unique
  ogImage         Media?   @relation("SeoOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  twitterCard     String?  @default("summary_large_image")
  twitterImageId  String?  @unique
  twitterImage    Media?   @relation("SeoTwitterImage", fields: [twitterImageId], references: [id], onDelete: SetNull)
  canonicalUrl    String?
  keywords        String?
  noindex         Boolean  @default(false)
  structuredData  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  book            Book?
  homepageContent HomepageContent?
  aboutContent    AboutContent?
  siteSettings    SiteSettings?

  @@map("seo")
}

// ============================================================
// Books
// ============================================================

/// Only one published book exists in V1, but the shape supports an
/// unlimited catalog from day one — nothing here is "the one book"
/// special-cased.
model Book {
  id              String     @id @default(uuid())
  title           String
  slug            String     @unique
  description     String? // full, rich-text (HTML) product-page description
  excerpt         String // short description — cards, previews, meta fallback
  authorName      String     @default("Ahmad Mohamed Kassa")
  publicationDate DateTime?
  isbn            String?
  language        String     @default("English")
  category        String?
  tags            String[]   @default([])
  status          BookStatus @default(DRAFT)
  featured        Boolean    @default(false)

  coverImageId String? @unique
  coverImage   Media?  @relation("BookCover", fields: [coverImageId], references: [id], onDelete: SetNull)

  // Purchase options — Amazon is the only live channel today; the rest
  // are modelled now so they're a data-entry task, not a migration,
  // once features.directBookSales flips on.
  amazonUrl           String?
  directPurchaseUrl   String?
  signedCopyAvailable Boolean @default(false)
  ebookUrl            String?
  audiobookUrl        String?

  seoId String? @unique
  seo   Seo?    @relation(fields: [seoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gallery            Media[]           @relation("BookGallery")
  featuredInHomepage HomepageContent[] @relation("HomepageFeaturedBook")

  @@index([status])
  @@index([featured])
  /// Matches bookService.listPublic()'s actual query — filter on
  /// status, order by featured then publicationDate.
  @@index([status, featured])
  @@map("books")
}

// ============================================================
// Editable page content (singletons)
// ============================================================

/// Singleton row (fixed id) — one homepage, always upserted against
/// the same id rather than queried as a list.
model HomepageContent {
  id                    String  @id @default("homepage")
  heroEyebrow           String  @default("Islamic Teacher · Author · Khateeb")
  heroHeadline          String
  heroSubtitle          String
  heroPrimaryCtaLabel   String  @default("Explore Books")
  heroPrimaryCtaHref    String  @default("/books")
  heroSecondaryCtaLabel String  @default("Browse Articles")
  heroSecondaryCtaHref  String  @default("/articles")
  heroImageId           String? @unique
  heroImage             Media?  @relation("HomepageHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)

  /// LEGACY/ORPHANED (Sprint 24) — superseded by the structured
  /// `about*` fields below. Never read by any production code path
  /// (confirmed by grep before this field was deprecated); its one
  /// existing row's value predates every editorial rebuild since and
  /// doesn't match anything ever actually shown publicly. Kept,
  /// untouched, for this sprint only under the EXPAND strategy —
  /// scheduled for removal in a later CONTRACT migration once the
  /// fields below are proven live. Do not read from this field.
  aboutPreviewText String

  /// The homepage's own short-form "Who Teaches Here" copy — a
  /// deliberately shortened editorial summary, not a duplicate of
  /// AboutContent's full biography (Sprint 24). Defaults match the
  /// copy actually live on the page today (verified against
  /// `about-preview-section.tsx` directly, not assumed), so migrating
  /// an existing row never produces empty/broken public output.
  aboutEyebrow  String @default("Who teaches here")
  aboutSubtitle String @default("Author · Teacher · Khateeb")
  aboutLede     String @default("His work brings together Islamic teaching, community service, and more than fifteen years of experience in Ruqyah.")
  aboutBody     String @default("Ahmad Mohamed Kassa studied Arabic and Islamic Studies in Kuwait before completing a degree in Computer Science and Telecommunications and a PGCE at the University of London. He has taught Ruqyah in the UK and abroad since 2009 and serves as Khateeb at Masjid Al-Noor in East London.")

  featuredBookId String?
  featuredBook   Book?   @relation("HomepageFeaturedBook", fields: [featuredBookId], references: [id], onDelete: SetNull)

  /// The three explicit slots the public Latest Khutbah section
  /// renders (Sprint 24) — not a generic feature+order flag, so the
  /// schema itself makes "what does the visitor see" obvious. Each is
  /// independently nullable; `resolveFeaturedKhutbahs()`
  /// (src/lib/featured-khutbahs.ts) promotes the next available slot
  /// forward if one is missing or its video gets unpublished/deleted.
  primaryKhutbahId     String?
  primaryKhutbah       Video?  @relation("HomepagePrimaryKhutbah", fields: [primaryKhutbahId], references: [id], onDelete: SetNull)
  supportingKhutbah1Id String?
  supportingKhutbah1   Video?  @relation("HomepageSupportingKhutbah1", fields: [supportingKhutbah1Id], references: [id], onDelete: SetNull)
  supportingKhutbah2Id String?
  supportingKhutbah2   Video?  @relation("HomepageSupportingKhutbah2", fields: [supportingKhutbah2Id], references: [id], onDelete: SetNull)

  newsletterHeadline String        @default("Stay connected, without the noise")
  newsletterText     String
  seoId              String?       @unique
  seo                Seo?          @relation(fields: [seoId], references: [id], onDelete: SetNull)
  status             ContentStatus @default(PUBLISHED)
  updatedAt          DateTime      @updatedAt

  credentials HomepageCredential[]

  @@index([featuredBookId])
  @@index([primaryKhutbahId])
  @@index([supportingKhutbah1Id])
  @@index([supportingKhutbah2Id])
  @@map("homepage_content")
}

/// The homepage About Preview's scannable credential list ("Arabic &
/// Islamic Studies — Kuwait", "PGCE — University of London", ...) —
/// normalized like TimelineItem/EducationItem below, not a JSON blob,
/// so entries can be added/reordered/removed individually. Capped at
/// 4 in the validation layer (src/schemas/homepage.schema.ts) to match
/// the composition's actual tested vertical rhythm — the section's
/// narrow `max-w-xs` mono column was built and reviewed around exactly
/// four short lines; a 5th would visibly outgrow the portrait beside it.
model HomepageCredential {
  id                String          @id @default(uuid())
  homepageContentId String          @default("homepage")
  homepageContent   HomepageContent @relation(fields: [homepageContentId], references: [id], onDelete: Cascade)
  label             String
  order             Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([homepageContentId, order])
  @@map("homepage_credentials")
}

/// A real, published video/khutbah — the canonical source for the
/// homepage's Latest Khutbah section (Sprint 24), replacing the static
/// src/lib/data/lectures.ts as production's source of truth (that file
/// remains only as a vitest fixture). No podcast/audio/analytics
/// fields — this models exactly what the admin video workflow and the
/// public 1-primary + 2-supporting layout need, nothing speculative.
model Video {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  youtubeId       String
  thumbnailUrl    String
  publishedAt     DateTime?
  durationMinutes Int?
  /// Free text (e.g. "Masjid Al-Noor") — not a channel-sync feature.
  source          String?
  /// Free text (e.g. "Weekly Khutbah") — deliberately not an enum;
  /// the one real value in use today doesn't justify a closed set yet.
  category        String?
  status          ContentStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  primaryOfHomepage     HomepageContent[] @relation("HomepagePrimaryKhutbah")
  supporting1OfHomepage HomepageContent[] @relation("HomepageSupportingKhutbah1")
  supporting2OfHomepage HomepageContent[] @relation("HomepageSupportingKhutbah2")

  @@index([status])
  @@index([publishedAt])
  @@map("videos")
}

/// Singleton row (fixed id). Timeline and education entries are
/// normalized child tables (ordered, independently editable) rather
/// than JSON blobs, since the dashboard needs to add/reorder/remove
/// individual entries.
model AboutContent {
  id               String   @id @default("about")
  introHeadline    String   @default("Ahmad Mohamed Kassa")
  introText        String
  biography        String
  missionText      String
  futureVisionText String
  badges           String[] @default([])
  seoId            String?  @unique
  seo              Seo?     @relation(fields: [seoId], references: [id], onDelete: SetNull)
  updatedAt        DateTime @updatedAt

  timeline  TimelineItem[]
  education EducationItem[]

  @@map("about_content")
}

model TimelineItem {
  id             String       @id @default(uuid())
  aboutContentId String       @default("about")
  aboutContent   AboutContent @relation(fields: [aboutContentId], references: [id], onDelete: Cascade)
  label          String
  title          String
  description    String
  order          Int          @default(0)

  @@index([aboutContentId, order])
  @@map("timeline_items")
}

model EducationItem {
  id             String       @id @default(uuid())
  aboutContentId String       @default("about")
  aboutContent   AboutContent @relation(fields: [aboutContentId], references: [id], onDelete: Cascade)
  title          String
  detail         String
  order          Int          @default(0)

  @@index([aboutContentId, order])
  @@map("education_items")
}

// ============================================================
// Communication
// ============================================================

/// The public-facing "ticket" — one row per submission. Deliberately
/// does NOT store the message body itself (that's the first Message in
/// its Conversation) — Question is the case file; Conversation/Message
/// is the actual back-and-forth. This split is what lets V2 add admin
/// replies, visitor replies, and a customer portal without touching
/// this table's shape at all.
model Question {
  id              String           @id @default(uuid())
  /// Human-facing lookup, e.g. "AMK-2026-000023" — shown in every
  /// email and the dashboard so a visitor can reference it later
  /// without needing an account. Generated via ReferenceCounter.
  referenceNumber String           @unique
  name            String
  email           String
  category        QuestionCategory
  subject         String?
  /// The visitor's original question text — kept here (in addition to
  /// living as the first Message) purely so list views, search, and
  /// the confirmation email don't need a join for the common case.
  /// The canonical, growable record of the exchange is `conversation`.
  initialMessage  String
  status          QuestionStatus   @default(NEW)
  priority        QuestionPriority @default(NORMAL)
  isPrivate       Boolean          @default(false)
  flagged         Boolean          @default(false)
  /// Staff read-tracking — independent of `status`, so "someone opened
  /// this" and "where this stands in the workflow" can't get confused
  /// with each other.
  readAt          DateTime?
  assignedToId    String?
  assignedTo      User?            @relation("QuestionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  conversation  Conversation?
  notes         InternalNote[]
  notifications UserNotification[]

  @@index([status])
  @@index([category])
  @@index([assignedToId])
  @@map("questions")
}

/// One per Question today (1:1) — modelled as its own table rather
/// than inlining messages onto Question so a future "visitor replies,
/// admin replies" thread is just more Message rows, never a migration.
model Conversation {
  id         String    @id @default(uuid())
  questionId String    @unique
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   Message[]

  @@map("conversations")
}

/// A single entry in a Conversation. V1 only ever creates one USER
/// message (the original submission) — ADMIN messages, attachments,
/// and read receipts are all real columns already, waiting for the
/// reply feature rather than requiring one.
model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     SenderType
  /// Which admin sent this — null for USER messages (visitors don't
  /// have accounts yet) and for the one auto-created USER message.
  senderUserId   String?
  senderUser     User?        @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  message        String
  /// Reserved for future file uploads — an array of Media ids/urls.
  /// Always null until attachments ship; not read anywhere yet.
  attachments    Json?
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId])
  @@map("messages")
}

/// Staff-only annotations on a Question — never rendered anywhere a
/// visitor (now or in a future portal) could see them. Deliberately a
/// separate table from Message, not a third SenderType, so "internal"
/// can never leak into the conversation history by a filtering bug.
model InternalNote {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  note       String
  createdAt  DateTime @default(now())

  @@index([questionId])
  @@map("internal_notes")
}

/// Tracks visitor-facing notification delivery per Question — reserved
/// for a future "your question was answered" email/portal alert.
/// Populated honestly today (emailSent flips true right after the
/// confirmation email send succeeds) rather than left as a pure stub.
model UserNotification {
  id           String    @id @default(uuid())
  questionId   String
  question     Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  emailSent    Boolean   @default(false)
  lastReminder DateTime?
  createdAt    DateTime  @default(now())

  @@index([questionId])
  @@map("user_notifications")
}

/// Atomic per-key counters — currently only backs Question reference
/// numbers ("question-2026" -> 23), but the key is a free-form string
/// so any future sequential-number need (invoices, bookings, contact
/// references) reuses this instead of inventing another counter table.
model ReferenceCounter {
  key   String @id
  value Int    @default(0)

  @@map("reference_counters")
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  reason    ContactReason @default(GENERAL)
  subject   String        @default("")
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status])
  /// Admin inbox default sort.
  @@index([createdAt])
  @@map("contact_messages")
}

/// A calm, low-frequency announcement list, not a marketing database.
/// `email` keeps its original casing (shown in the dashboard);
/// `normalizedEmail` (lowercased + trimmed) is the unique key every
/// lookup/dedup actually uses, so "Name@Example.com" and
/// "name@example.com" are always the same subscriber. Confirmation
/// tokens are single-use/expiring and stored only as a hash — the raw
/// token exists solely in the outgoing email/URL, never persisted
/// (unlike the older, out-of-scope `PasswordResetToken`, which stores
/// its token raw). Unsubscribe links need no stored token at all — see
/// src/lib/newsletter-token.ts's `unsubscribeToken()`.
model NewsletterSubscriber {
  id                         String           @id @default(uuid())
  email                      String           @unique
  normalizedEmail            String           @unique
  firstName                  String?
  /// Stored for a future multilingual rollout; not yet exposed as a
  /// form control (see features.multilingual).
  preferredLanguage          String           @default("en")
  status                     SubscriberStatus @default(PENDING)
  source                     SubscriberSource @default(OTHER)
  /// Which version of the on-page consent copy was shown at signup —
  /// bump the constant in code (not this schema) when the wording
  /// changes, so historical consent stays attributable to what a
  /// subscriber actually saw.
  consentTextVersion         String?
  consentedAt                DateTime?
  confirmedAt                DateTime?
  unsubscribedAt             DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  lastEmailSentAt            DateTime?
  emailFailureCount          Int              @default(0)
  /// Set only when status is SUPPRESSED/BOUNCED/COMPLAINED — why this
  /// address will never be emailed again.
  suppressionReason          String?
  confirmationTokenHash      String?
  confirmationTokenExpiresAt DateTime?
  metadata                   Json?

  campaignRecipients CampaignRecipient[]

  @@index([status])
  @@index([source])
  @@index([confirmationTokenHash])
  @@map("newsletter_subscribers")
}

model Campaign {
  id               String               @id @default(uuid())
  /// Admin-only label shown in the campaigns list — never sent.
  internalName     String
  /// The heading rendered inside the email body.
  title            String
  subject          String
  previewText      String?
  /// Rich HTML from the shared Tiptap editor.
  content          String
  plainTextContent String
  ctaLabel         String?
  ctaUrl           String?
  secondaryContent String?
  status           CampaignStatus       @default(DRAFT)
  audienceType     CampaignAudienceType @default(ALL_ACTIVE)
  language         String               @default("en")
  /// Nullable overrides of NewsletterSettings' defaults.
  senderName       String?
  replyToEmail     String?
  scheduledFor     DateTime?
  sentAt           DateTime?
  createdById      String?
  createdBy        User?                @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?                @relation("CampaignUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  /// Resend batch-send id, once a send has started.
  providerBatchId  String?
  recipientCount   Int                  @default(0)
  successCount     Int                  @default(0)
  failureCount     Int                  @default(0)

  recipients CampaignRecipient[]

  @@index([status])
  @@map("campaigns")
}

/// Per-subscriber delivery tracking for one campaign send. The
/// `@@unique` below is the duplicate-delivery guard: a send action that
/// re-runs against an already-populated recipient set can't insert the
/// same subscriber twice, and only ever processes rows still PENDING.
model CampaignRecipient {
  id                String                  @id @default(uuid())
  campaignId        String
  campaign          Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId      String
  subscriber        NewsletterSubscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  status            CampaignRecipientStatus @default(PENDING)
  sentAt            DateTime?
  error             String?
  providerMessageId String?
  createdAt         DateTime                @default(now())

  @@unique([campaignId, subscriberId])
  @@index([campaignId])
  @@index([subscriberId])
  @@index([providerMessageId])
  @@map("campaign_recipients")
}

/// Singleton row (fixed id), same pattern as SiteSettings/
/// HomepageContent — always a plain `.update()`, never `.upsert()`.
model NewsletterSettings {
  id                           String   @id @default("newsletter")
  senderName                   String   @default("Ahmad Kassa")
  senderEmail                  String   @default("newsletter@ahmadkassa.com")
  replyToEmail                 String?
  confirmationSubject          String   @default("Confirm your subscription")
  welcomeSubject               String   @default("Welcome — you're subscribed")
  defaultFooterText            String?
  businessAddress              String?
  defaultLanguage              String   @default("en")
  confirmationTokenExpiryHours Int      @default(48)
  testEmailAllowlist           String[] @default([])
  updatedAt                    DateTime @updatedAt

  @@map("newsletter_settings")
}

// ============================================================
// Site-wide settings (singleton)
// ============================================================

model SiteSettings {
  id           String   @id @default("site")
  websiteName  String   @default("Ahmad Mohamed Kassa")
  domain       String   @default("https://ahmadkassa.com")
  contactEmail String
  supportEmail String?
  socialLinks  Json     @default("{}")
  footerText   String?
  navigation   Json     @default("[]")
  logoId       String?  @unique
  logo         Media?   @relation("SiteLogo", fields: [logoId], references: [id], onDelete: SetNull)
  brandColors  Json     @default("{}")
  analyticsIds Json     @default("{}")
  defaultSeoId String?  @unique
  defaultSeo   Seo?     @relation(fields: [defaultSeoId], references: [id], onDelete: SetNull)
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}
