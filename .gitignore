# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# local-dev media uploads (storageService writes here; production uses
# Vercel Blob instead — see src/services/storage.ts)
/public/uploads

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never committed; .env.example has no
# secrets and is meant to be a shared reference (see docs/DEPLOYMENT.md)
.env*
!.env.example

# vercel
.vercel

# Neon CLI local project/branch link (project/org IDs only, no
# secrets) — machine-specific, not meant to be shared via git
.neon

# Auto-installed by the `neon`/`neon-postgres` agent skills the first
# time either is invoked (root-owned, not deletable by the app's own
# user). Unlike the other .agents/.claude skill directories in this
# repo, these were never a deliberate, tracked part of the project, so
# they're ignored rather than committed.
.agents/skills/neon/
.agents/skills/neon-postgres/
.claude/skills/neon/
.claude/skills/neon-postgres/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Designer reference/delivery comps and watermarked drafts — not the
# authoritative source. AHMAD.ai (Illustrator master) and AHMAD-06.svg
# (the vector export every production mark file derives from) are
# tracked; these are kept locally only for provenance, and two of them
# still carry a visible Fiverr watermark. See public/brand/README.md.
/brand-source/1.png
/brand-source/2.jpg
/brand-source/512x512.jpg
/brand-source/AHMAD.jpg
/brand-source/New.jpg
/brand-source/just-logo.jpg
/brand-source/just-logo.png
