# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Prisma). Local dev or a managed provider
# (Neon, Vercel Postgres via Marketplace, Supabase, RDS, etc.) all work
# identically — this is the only line that changes between environments.
DATABASE_URL="postgresql://user:password@localhost:5432/ahmad_kassa?schema=public"

# Auth.js — signs/encrypts session JWTs and CSRF tokens. Generate with
# `openssl rand -base64 32`. Rotating this invalidates every active
# session. Set AUTH_TRUST_HOST=true in any environment without a fixed
# canonical URL configured (e.g. local dev, preview deployments).
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Resend — transactional email (newsletter, Ask Ahmad, Contact, and
# password reset since Sprint 5).
RESEND_API_KEY=""

# Newsletter (Sprint 8) — sender identity defaults; both are also
# editable from /admin/newsletter/settings, which takes precedence once
# saved. RESEND_FROM_EMAIL must be on a domain verified in Resend.
RESEND_FROM_EMAIL=""
RESEND_REPLY_TO_EMAIL=""

# Newsletter (Sprint 8) — verifies incoming Resend delivery webhooks
# (bounce/complaint events) at /api/webhooks/resend. Copy the "Signing
# Secret" from the webhook's settings in the Resend dashboard.
RESEND_WEBHOOK_SECRET=""

# Newsletter (Sprint 8) — peppers confirmation/unsubscribe token
# hashes. Generate with `openssl rand -base64 32`. Required in
# production; rotating it invalidates every pending confirmation link
# and every previously-sent unsubscribe link.
NEWSLETTER_TOKEN_SECRET=""

# Base URL for the whole site's canonical/OG/sitemap/robots metadata
# (Sprint 9) and newsletter confirmation/unsubscribe links (Sprint 8).
# Falls back to the hardcoded ahmadkassa.com domain if unset — set
# this explicitly in any environment where the real deployment URL
# differs (a preview deployment, or before the production domain is
# connected).
NEXT_PUBLIC_SITE_URL=""

# Search Console / Bing Webmaster Tools ownership verification (Sprint
# 9) — paste the "content" value from each provider's HTML meta-tag
# verification method. Both optional; add once the production domain
# is connected and you're ready to verify it in each console.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# Newsletter (Sprint 8, reserved) — only needed once
# features.newsletterScheduling ships and a Vercel Cron job is wired up
# to trigger scheduled sends. Not required today.
# CRON_SECRET=""

# Stripe — architecture only, not wired up yet (see src/features/flags.ts).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
